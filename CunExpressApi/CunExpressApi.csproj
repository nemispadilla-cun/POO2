<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Proyecto ASP.NET Core Web API del modulo 7 (G7): el SERVIDOR.
       La demo de consola (ejecutar.bat 7) es el CLIENTE que lo consume.
       Se arranca con api.bat desde la raiz del repositorio. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Cun.Poo.CunExpressApi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger: documentacion y pagina para probar la API desde el navegador -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
