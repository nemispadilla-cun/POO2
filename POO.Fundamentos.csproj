<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 es LTS y la instalan por defecto Visual Studio 2022 y Rider.
         Si en tu maquina solo tienes .NET 9 o 10, cambia este valor. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Cun.Poo</RootNamespace>
    <AssemblyName>POO.Fundamentos</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Configuracion que lee el Singleton AppConfig del modulo 4 (G4).
         Se copia junto al ejecutable conservando la ruta relativa. -->
    <None Update="Modulo04_Patrones\Creacionales\microcreditos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Modulo 6 (G6): el ORM de .NET (equivalente de Hibernate/JPA) con SQLite,
         una base de datos en un solo archivo que no necesita servidor.
         Es el unico paquete NuGet del curso; dotnet build lo descarga solo. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- La ventana del modulo 5 (G5) es otro proyecto, solo para Windows.
         Se excluye para que este proyecto no compile sus archivos. -->
    <Compile Remove="Modulo05_GUI\CalculadoraWinForms\**" />
    <None Remove="Modulo05_GUI\CalculadoraWinForms\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- La Web API del modulo 7 (G7) es OTRO ejecutable (el SERVIDOR), en la
         carpeta CunExpressApi/, y se arranca con api.bat. Este proyecto de consola es solo el CLIENTE. -->
    <Compile Remove="CunExpressApi\**" />
    <None Remove="CunExpressApi\**" />
    <Content Remove="CunExpressApi\**" />
  </ItemGroup>

</Project>
